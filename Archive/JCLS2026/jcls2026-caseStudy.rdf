<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.loa.istc.cnr.it/cs#"
     xml:base="https://www.loa.istc.cnr.it/cs"
     xmlns:obs="https://www.loa.istc.cnr.it/obs#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://www.loa.istc.cnr.it/cs">
        <owl:imports rdf:resource="https://raw.githubusercontent.com/appliedontolab/MITE/refs/heads/main/core-ontology/core-module.rdf"/>
        <terms:contributor>Gaia Tomazzoli</terms:contributor>
        <terms:creator>Alessandro Mosca</terms:creator>
        <terms:creator>Case study presented in the paper:
&quot;Modeling and Reasoning over Observations: An Ontology for Literary Criticism&quot;, submitted to the Journal of Computational Literary Studies (under review)</terms:creator>
        <terms:creator>Claudio Masolo</terms:creator>
        <terms:creator>Emilio Sanfilippo</terms:creator>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0"/>
        <rdfs:comment>Created in the context of the research project &quot;MITE - Make it explicit: Documenting interpretations of literary fictions with conceptual formal models&quot; (2023-2025) funded by the European Union - Next Generation EU.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://www.loa.istc.cnr.it/cs#characterIn -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#characterIn">
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/obs#Text"/>
        <rdfs:label>character in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#hasBeloved -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#hasBeloved">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#LoveRelObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#hasGuide -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#hasGuide">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#GuideRelObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#hasGuided -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#hasGuided">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#GuideRelObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#hasLover -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#hasLover">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#LoveRelObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#hasReplaced -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#hasReplaced">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#ReplacingRelObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#hasReplacing -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#hasReplacing">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#ReplacingRelObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#inFunctionOf -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#inFunctionOf">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/cs#ReplacingRelObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#inText -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#inText">
        <rdfs:subPropertyOf rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/obs#BasicObs"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/obs#Text"/>
    </owl:ObjectProperty>
    


    <!-- https://www.loa.istc.cnr.it/cs#partiallyAgreesWith -->

    <owl:ObjectProperty rdf:about="https://www.loa.istc.cnr.it/cs#partiallyAgreesWith">
        <rdfs:domain rdf:resource="https://www.loa.istc.cnr.it/obs#Text"/>
        <rdfs:range rdf:resource="https://www.loa.istc.cnr.it/obs#Text"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://www.loa.istc.cnr.it/cs#AffectiveFunctObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#AffectiveFunctObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeFunctionObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://www.loa.istc.cnr.it/cs#SymbolicFunctObs"/>
        <rdfs:label>Affective Function Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#Character -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#Character">
        <rdfs:label>Character</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#EroticLoveRelObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#EroticLoveRelObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#LoveRelObs"/>
        <owl:disjointWith rdf:resource="https://www.loa.istc.cnr.it/cs#SalvificLoveRelObs"/>
        <rdfs:label>Erotic Love Relation Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#FemaleObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#FemaleObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#GenderObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Female Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#GenderObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#GenderObs">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#FemaleObs"/>
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#MaleObs"/>
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#UngenderedObs"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/obs#BasicObs"/>
        <owl:disjointWith rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeFunctionObs"/>
        <owl:disjointWith rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeRelationObs"/>
        <rdfs:label>Gender Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#GuideRelObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#GuideRelObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeRelationObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#hasGuide"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#hasGuided"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#inText"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/obs#Text"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://www.loa.istc.cnr.it/cs#LoveRelObs"/>
        <owl:disjointWith rdf:resource="https://www.loa.istc.cnr.it/cs#ReplacingRelObs"/>
        <rdfs:label>Guide Relation Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#GuideReplacingRelObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#GuideReplacingRelObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#ReplacingRelObs"/>
        <rdfs:label>Guide Replacing Relation Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#LoveRelObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#LoveRelObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeRelationObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#hasBeloved"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#hasLover"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#inText"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/obs#Text"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Love Relation Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#MaleObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#MaleObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#GenderObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Male Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#NarrativeFunctionObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#NarrativeFunctionObs">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#AffectiveFunctObs"/>
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#SymbolicFunctObs"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/obs#BasicObs"/>
        <owl:disjointWith rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeRelationObs"/>
        <rdfs:label>Narrative Function Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#NarrativeRelationObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#NarrativeRelationObs">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#GuideRelObs"/>
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#LoveRelObs"/>
                    <rdf:Description rdf:about="https://www.loa.istc.cnr.it/cs#ReplacingRelObs"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/obs#BasicObs"/>
        <rdfs:label>Narrative Relation Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#ReplacingRelObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#ReplacingRelObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeRelationObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#hasReplaced"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#hasReplacing"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#inFunctionOf"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/cs#inText"/>
                <owl:someValuesFrom rdf:resource="https://www.loa.istc.cnr.it/obs#Text"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel>Replacing Relation Obs</skos:altLabel>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#SalvificLoveRelObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#SalvificLoveRelObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#LoveRelObs"/>
        <rdfs:label>Salvific Love Relation Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#SymbolicFunctObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#SymbolicFunctObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#NarrativeFunctionObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Symbolic Function Obs</rdfs:label>
    </owl:Class>
    


    <!-- https://www.loa.istc.cnr.it/cs#UngenderedObs -->

    <owl:Class rdf:about="https://www.loa.istc.cnr.it/cs#UngenderedObs">
        <rdfs:subClassOf rdf:resource="https://www.loa.istc.cnr.it/cs#GenderObs"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.loa.istc.cnr.it/obs#hasArgument"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.loa.istc.cnr.it/cs#Character"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ungendered Obs</rdfs:label>
    </owl:Class>
    


